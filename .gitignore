# Build artifacts
/bin/
/dist/
*.wasm
*.test
*.out
# Copied from the Go toolchain by client/wasm/build.sh — never authored here,
# and would drift from whatever Go version actually built the .wasm next to
# it if committed once and forgotten.
/client/web/wasm_exec.js
# `go build ./...` (rather than build.sh) run directly inside client/wasm
# produces an extensionless binary named after the directory — *.wasm above
# does not catch it since it carries no extension.
/client/wasm/wasm

# Go
/vendor/

# Runtime data of a local node — must never end up in the repo
*.db
*.db-wal
*.db-shm
/blobs/

# Key material. Private keys do not belong in version control.
*.key
*.pem
/secrets/

# WordPress application password for editing openwaymark.org — a website
# credential, unrelated to the protocol, never belongs in this repo.
wp-app-password.txt

# Local project notes, not for the repository.
/CLAUDE.md

# Editor and operating system
.DS_Store
*~
.idea/
.vscode/

# Local code-indexing tool state, not project data.
/.tokensave/
