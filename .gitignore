# Build artifacts
/bin/
/dist/
*.wasm
*.test
*.out

# Go
/vendor/

# Runtime data of a local node — must never end up in the repo
*.db
*.db-wal
*.db-shm
/blobs/

# Key material. Private keys do not belong in version control.
*.key
*.pem
/secrets/

# WordPress application password for editing openwaymark.org — a website
# credential, unrelated to the protocol, never belongs in this repo.
wp-app-password.txt

# Project-internal working notes. Deliberately never version-controlled —
# purged from history 2026-08-17/18. Stays on disk for local use; a CI job
# (guard-no-claude-md) additionally fails the build if this is ever tracked.
/CLAUDE.md

# Editor and operating system
.DS_Store
*~
.idea/
.vscode/
