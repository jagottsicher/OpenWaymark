{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Processing",
  "description": "Smelting or refining: raw material in, refined metal out - the OECD's own control point (spec Sec.3). The chain of origin stays traceable because the inputs are listed in the entry's par field.",
  "type": "object",
  "required": ["process", "inputs", "outputs"],
  "properties": {
    "process": {
      "description": "What was done, e.g. \"smelting\" or \"refining\".",
      "$ref": "defs.json#/$defs/text"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "defs.json#/$defs/item" }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "defs.json#/$defs/item" }
    }
  }
}
