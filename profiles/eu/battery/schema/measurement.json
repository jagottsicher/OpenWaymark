{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Measurement",
  "description": "State of health, cycle count, capacity - the passport's ongoing data, not only its birth certificate. Has to be submitted with entry type sensor_reading and to come from a device key.",
  "type": "object",
  "required": ["sensor", "quantity_kind", "unit", "readings"],
  "properties": {
    "sensor": {
      "type": "object",
      "properties": {
        "id": { "$ref": "defs.json#/$defs/text" },
        "key": {
          "description": "Key identifier of the device. A sensor's trust level is capped by that of its operator.",
          "$ref": "defs.json#/$defs/keyid"
        },
        "model": { "$ref": "defs.json#/$defs/text" }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "quantity_kind": {
      "enum": ["state_of_health", "capacity", "cycles", "temperature"]
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8
    },
    "readings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "properties": {
          "t": { "$ref": "defs.json#/$defs/timestamp" },
          "v": { "type": "number" }
        },
        "required": ["t", "v"],
        "additionalProperties": false
      }
    }
  }
}
