{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handover",
  "description": "Change of ownership along the chain.",
  "type": "object",
  "required": ["to"],
  "properties": {
    "from": { "$ref": "defs.json#/$defs/party" },
    "to": { "$ref": "defs.json#/$defs/party" },
    "transaction": {
      "type": "object",
      "properties": {
        "type": {
          "enum": ["po", "desadv", "inv", "other"]
        },
        "id": { "$ref": "defs.json#/$defs/text" }
      },
      "required": ["id"],
      "additionalProperties": false
    }
  }
}
